# Public values are bundled into the app. Never put secrets here.
# Expo Go development: localhost is replaced with Metro's private LAN IPv4 host.
# For a remote API or Metro tunnel, set an explicitly phone-reachable API origin.
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_APP_VARIANT=development
# Public identifiers, never credentials. EAS_PROJECT_ID optionally overrides the linked project.
EAS_PROJECT_ID=
APP_LINK_HOST=
SENTRY_ORG=
SENTRY_PROJECT=
# EAS secret file variable for Android FCM; never commit its content.
GOOGLE_SERVICES_JSON=
# SENTRY_AUTH_TOKEN belongs only in the EAS secret environment, never EXPO_PUBLIC_*.
