# Public values are bundled into the app. Never put secrets here.
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_APP_VARIANT=development
# Public identifiers, never credentials. Required for EAS build/update and device push.
EAS_PROJECT_ID=
APP_LINK_HOST=
SENTRY_ORG=
SENTRY_PROJECT=
# EAS secret file variable for Android FCM; never commit its content.
GOOGLE_SERVICES_JSON=
# SENTRY_AUTH_TOKEN belongs only in the EAS secret environment, never EXPO_PUBLIC_*.
